# Copy to .env; replace placeholders with local secrets. Never commit .env.
POSTGRES_USER=traceai
POSTGRES_DB=traceai
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=5432
TRACEAI_DATABASE_URL=postgresql+psycopg://traceai:replace-with-local-password@127.0.0.1:5432/traceai
# Required when protected endpoints are implemented in chunk 3.
TRACEAI_API_TOKEN=replace-with-api-token
TRACEAI_RESET_TOKEN=replace-with-distinct-reset-token
# Isolated database for integration tests; create and migrate it separately.
TRACEAI_TEST_DATABASE_URL=postgresql+psycopg://traceai:replace-with-local-password@127.0.0.1:5432/traceai_test
